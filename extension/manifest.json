{
  "manifest_version": 3,
  "name": "YouTube Ad Skipper",
  "short_name": "Ad Skipper",
  "version": "1.1.0",
  "description": "Automatically skips YouTube video ads and hides banner, feed and overlay ads. No Premium needed.",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "css": ["hide-ads.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "YouTube Ad Skipper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "32": "images/toolbar-32.png"
    }
  },
  "browser_specific_settings": {
    "safari": { "strict_min_version": "16.4" }
  }
}
